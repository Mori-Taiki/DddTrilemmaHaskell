cabal-version: 3.0
name: ddd-trilemma
version: 0.1.0.0
build-type: Simple
synopsis: Typed, demand-driven decisions for story access
extra-source-files: README.md

common settings
  default-language: GHC2021
  ghc-options: -Wall -Werror=incomplete-patterns
  default-extensions: OverloadedStrings

library
  import: settings
  hs-source-dirs: src
  exposed-modules: Story.Domain, Story.Decision, Story.Store, Story.Http
  other-modules: Story.Labels
  build-depends: base >= 4.16 && < 5, aeson >= 2 && < 3, bytestring,
                 http-types, sqlite-simple >= 0.4.19 && < 0.5, text, wai

executable story-api
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded
  build-depends: base, ddd-trilemma, warp

test-suite spec
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules: DomainSpec, StoreSpec, HttpSpec, Fixtures
  ghc-options: -threaded
  build-depends: base, aeson, async, bytestring, ddd-trilemma, hspec,
                 http-types, sqlite-simple, temporary, text, wai, wai-extra
